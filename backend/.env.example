# Sharexpress Cloud Backend — Environment Configuration
# Copy this file to .env and fill in all values before deploying.
# NEVER commit the .env file to version control.

# =============================================================
# ENVIRONMENT
# =============================================================
PROJECT_ENVIRONMENT=PRODUCTION    # Options: DEVELOPMENT | PRODUCTION

# =============================================================
# SERVICE URLS
# =============================================================
FRONTEND_URL=https://cloud.sharexpress.in
BACKEND_URL=https://api.sharexpress.in

# =============================================================
# MONGODB
# =============================================================
MONGO_URI=mongodb://user:password@mongo-host:27017/sharexpress_cloud?authSource=admin
DB_NAME=sharexpress_cloud

# =============================================================
# REDIS
# =============================================================
REDIS_HOST=redis-host
REDIS_PORT=6379

# =============================================================
# CRYPTOGRAPHIC SECRETS — generate fresh values for each environment
# Generate ENCRYPTION_MASTER_KEY:  python3 -c "import secrets; print(secrets.token_urlsafe(42))"
# Generate SESSION_SECRET_KEY:     python3 -c "import secrets; print(secrets.token_urlsafe(42))"
# =============================================================
ENCRYPTION_MASTER_KEY=CHANGE_ME_GENERATE_FRESH_URLSAFE_42CHARS
SESSION_SECRET_KEY=CHANGE_ME_GENERATE_FRESH_URLSAFE_42CHARS

# =============================================================
# RS256 JWT — mount keys as files, NOT env vars
# Keys are loaded from: backend/app/core/security/private.pem
#                       backend/app/core/security/public.pem
# NEVER commit .pem files. Mount via Docker secrets or k8s Secret.
# =============================================================
JWT_ALGORITHM=RS256
JWT_EXPIRES=7   # Days

# =============================================================
# GOOGLE OAUTH
# =============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================
# GITHUB OAUTH
# =============================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================
# GITLAB OAUTH
# =============================================================
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# =============================================================
# SMTP (Email delivery for OTP)
# =============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@sharexpress.in
SMTP_FROM_NAME=Sharexpress Cloud

# =============================================================
# MINIO S3-COMPATIBLE OBJECT STORAGE
# =============================================================
MINIO_ENDPOINT=http://minio-host:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# =============================================================
# CORS
# =============================================================
BACKEND_CORS_ORIGINS=https://cloud.sharexpress.in
